{
  "info": {
    "_postman_id": "1078127e-2ede-4051-a88c-6541c82bd8ef",
    "name": "BNPB M2",
    "description": "Client API per peran, field report, DLQ, Audit API, dan status Aggregator. Token login diambil otomatis per peran (pre-request) dari password di environment. Test setiap request mencatat time_total dan X-Correlation-ID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "login_script",
      "value": "// Logs in once per role and reuses the access token until shortly before it expires (TTL 60 s).\nconst role = pm.collectionVariables.get('login_role');\nconst key = 'token_' + role.replace('-', '_');\nconst until = Number(pm.collectionVariables.get(key + '_until') || 0);\nif (Date.now() < until) { return; }\nconst password = pm.environment.get(role.replace('-', '_') + '_password');\npm.sendRequest({ url: pm.environment.get('auth_url') + '/login', method: 'POST',\n  header: { 'Content-Type': 'application/json' },\n  body: { mode: 'raw', raw: JSON.stringify({ client_id: role, password }) } }, (err, res) => {\n  if (err || res.code !== 200) { console.error('login failed for ' + role, err || res.code); return; }\n  const body = res.json();\n  pm.collectionVariables.set(key, body.access_token);\n  pm.collectionVariables.set(key + '_until', String(Date.now() + 50000));\n});"
    },
    {
      "key": "login_role",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Client API (publik)",
      "item": [
        {
          "name": "Media: GET /hazards (7 field ringkasan)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "postman-{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_media}}"
              }
            ],
            "url": "{{api_url}}/hazards?limit=5"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('login_role', 'media');",
                  "eval(pm.collectionVariables.get('login_script'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('time_total ' + pm.response.responseTime + ' ms, X-Correlation-ID ' + pm.response.headers.get('X-Correlation-ID'), () => true);",
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
