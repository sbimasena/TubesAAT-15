# Toolchain Go
GO_VERSION=1.27.1

# Mock BMKG
BMKG_PORT=8081
BMKG_BASE_URL=http://bmkg:8081
BMKG_API_KEY=dev-bmkg-key
BMKG_GENERATE_INTERVAL_SECONDS=15

# Mock PVMBG
PVMBG_PORT=8082
PVMBG_BASE_URL=http://pvmbg:8082
PVMBG_TOKEN=dev-pvmbg-token
PVMBG_DELAY_MS=750
PVMBG_GENERATE_INTERVAL_SECONDS=15

# Agregator
# Host port used only by tests/compose-operator.yml; Aggregator is internal by default.
AGGREGATOR_PORT=8083
POLL_INTERVAL_SECONDS=3

# Downstream services; port variables select host ports, container ports remain fixed.
CLIENT_API_PORT=8080
AGGREGATOR_BASE_URL=http://aggregator:8083
# Dependency timeout; tune only from load measurements.
AGGREGATOR_REQUEST_TIMEOUT_MS=5000
# Initial hazard concurrency bound; tune using P2 measurements.
CLIENT_API_MAX_CONCURRENT_REQUESTS=64
# Opt-in legacy checkpoint alias; Auth and field projection remain mandatory.
ENABLE_PROVISIONAL_HAZARD_ENDPOINT=false
# Auth listens on container port 8084; AUTH_PORT selects the localhost host port.
AUTH_PORT=8084
AUTH_BASE_URL=http://auth:8084
# Dependency timeout; tune only from load measurements.
AUTH_REQUEST_TIMEOUT_MS=5000
# Separate internal credential shared only by Auth and Client API; minimum 32 bytes.
AUTH_INTERNAL_SECRET=
ACCESS_TOKEN_TTL_SECONDS=60
# Required Auth configuration; keep real secrets in an uncommitted local file.
REFRESH_TOKEN_TTL_SECONDS=3600
# Signing secret must contain at least 32 bytes; keep the real value outside Git.
JWT_SIGNING_SECRET=
MEDIA_CLIENT_ID=media
MEDIA_CLIENT_PASSWORD=
FIELD_TEAM_CLIENT_ID=field-team
FIELD_TEAM_CLIENT_PASSWORD=
INTERNAL_OPS_CLIENT_ID=internal-ops
INTERNAL_OPS_CLIENT_PASSWORD=

# Canonical Store; hanya Aggregator menggunakan DATABASE_URL.
# Jika password di URL mengandung karakter khusus, gunakan URL encoding.
POSTGRES_DB=hazards
POSTGRES_USER=aggregator
POSTGRES_PASSWORD=dev-postgres-password
DATABASE_URL=postgres://aggregator:dev-postgres-password@canonical-store:5432/hazards?sslmode=disable

# RabbitMQ: AMQP hanya jaringan internal; management UI hanya localhost.
RABBITMQ_DEFAULT_USER=hazard
RABBITMQ_DEFAULT_PASS=dev-broker-password
RABBITMQ_MANAGEMENT_PORT=15672
BROKER_URL=amqp://hazard:dev-broker-password@message-broker:5672/
