{
  "uid": "bnpb-overview",
  "title": "BNPB Overview",
  "tags": [
    "bnpb"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput per service",
      "description": "Request HTTP per detik yang dilayani tiap service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(http_requests_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (5xx) per service",
      "description": "Porsi respons 5xx dari semua request; 0 bila belum ada error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (service) (rate(http_requests_total{code=~\"5..\"}[1m])) or sum by (service) (rate(http_requests_total[1m])) * 0) / sum by (service) (rate(http_requests_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latensi p95 per service",
      "description": "95% request selesai di bawah angka ini.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latensi p95 Aggregator per route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket{service=\"aggregator\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Slot partisi per unit store (P1)",
      "description": "Seimbang: 16 per unit dengan 3 unit. Unit yang hilang turun ke 0 setelah re-replikasi, unit lain naik ke 24.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bnpb_store_partitions",
          "legendFormat": "{{unit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Unit store terjangkau",
      "description": "1 = menjawab health check dalam 15 detik terakhir.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bnpb_store_unit_up",
          "legendFormat": "{{unit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Target scrape hidup",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"bnpb\"}",
          "legendFormat": "{{service}} {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Satellite offset lag",
      "description": "Request HTTP per detik yang dilayani tiap service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(bnpb_satellite_offset_lag >= 0) and on(instance, job) (bnpb_satellite_processor_ready == 1)",
          "refId": "A",
          "legendFormat": "{{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Satellite frame-to-commit p95",
      "description": "Request HTTP per detik yang dilayani tiap service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bnpb_satellite_ingest_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Satellite late / singleton detections",
      "description": "Request HTTP per detik yang dilayani tiap service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "{__name__=~\"bnpb_satellite_(late|single)_detections\"}",
          "refId": "A",
          "legendFormat": "{{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Satellite processor ready",
      "description": "Request HTTP per detik yang dilayani tiap service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "bnpb_satellite_processor_ready",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Alert kritis Pantai: ACK lokal dan sampel latensi",
      "description": "Estimasi 5 menit: ACK lokal tercatat (termasuk pemulihan ACK dalam proses yang sama) dan sampel latensi bertimestamp valid. Sampel latensi adalah penyebut rasio. Bukan jumlah alert dari sumber.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 40, "w": 8, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum(increase(notification_pantai_critical_acknowledged_total[5m]))", "legendFormat": "ACK lokal / 5m"},
        {"refId": "B", "expr": "sum(increase(notification_pantai_critical_age_seconds_count[5m]))", "legendFormat": "Sampel latensi / 5m"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Alert kritis Pantai: rasio ≤5 s",
      "description": "Target 99% berlaku untuk sampel dengan ingested_at valid, bukan seluruh alert kritis. Window 5 menit; tidak ada nilai jika tidak ada sampel. Tidak mengukur kehilangan alert.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 40, "w": 8, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum(rate(notification_pantai_critical_age_seconds_bucket{le=\"5\"}[5m])) / (sum(rate(notification_pantai_critical_age_seconds_count[5m])) > 0)", "legendFormat": "≤5 s"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.99}]}},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Alert kritis Pantai: p95 ingestion → ACK",
      "description": "Dari ingested_at sampai ACK lokal berhasil, setelah journal sync. Window 5 menit; bukan latensi dari waktu observasi sensor.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 40, "w": 8, "h": 8},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(notification_pantai_critical_age_seconds_bucket[5m]))) and (sum(rate(notification_pantai_critical_age_seconds_count[5m])) > 0)", "legendFormat": "p95"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 5}]}},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Error budget alert kritis tersisa (SLO 99% ≤5 s, 1 jam)",
      "description": "SLO jalur peringatan: 99% alert kritis Pantai di-ACK ≤5 s sejak masuk Aggregator. 100% = belum ada pelanggaran; 0% = budget habis; negatif = SLO dilanggar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (1 - sum(increase(notification_pantai_critical_age_seconds_bucket{le=\"5\"}[1h])) / (sum(increase(notification_pantai_critical_age_seconds_count[1h])) > 0)) / 0.01",
          "legendFormat": "budget"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Burn rate error budget alert kritis (5 m)",
      "description": "Kecepatan budget terpakai. 1 = habis tepat di akhir jendela; >14,4 selama 5 menit = budget 1 jam habis dalam ±4 menit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 48,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 - sum(rate(notification_pantai_critical_age_seconds_bucket{le=\"5\"}[5m])) / (sum(rate(notification_pantai_critical_age_seconds_count[5m])) > 0)) / 0.01",
          "legendFormat": "burn rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
